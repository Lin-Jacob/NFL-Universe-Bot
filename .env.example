# Copy this file to .env and fill it in. Never share or commit .env.

# --- Discord ---------------------------------------------------------------
# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Your server's ID (right-click server icon > Copy Server ID, Developer Mode on).
# With this set, slash commands appear instantly. Leave empty for global commands (slow to appear).
GUILD_ID=
# Optional: channel ID where final scores are posted. /admin channel overrides this.
ANNOUNCE_CHANNEL_ID=

# --- Webhook server --------------------------------------------------------
# Long random string. It becomes the last part of the webhook URL, so only
# NFL Universe (or whoever you give the URL to) can post games.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0

# --- Making the webhook reachable without a domain -------------------------
# cloudflared : free Cloudflare quick tunnel, no account. URL changes every restart.
# ngrok       : free ngrok account with one static domain, URL never changes.
# none        : no tunnel (you forward the port yourself; set PUBLIC_URL).
TUNNEL=cloudflared

# Only needed for TUNNEL=ngrok (dashboard.ngrok.com > Your Authtoken / Domains)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Only needed for TUNNEL=none, e.g. http://203.0.113.5:8080
PUBLIC_URL=

# Optional: full path to the tunnel program if it isn't on your PATH
CLOUDFLARED_PATH=
NGROK_PATH=

# DM every admin the webhook URL when the bot starts (handy with cloudflared)
DM_ADMINS_WEBHOOK_URL=true

# --- Option B: read game posts from a Discord channel ----------------------
# If NFL Universe only accepts a discord.com webhook URL, create a webhook in a
# channel (Channel settings > Integrations > Webhooks), paste THAT URL into the
# game, and put the channel's ID here. The bot reads every webhook post in that
# channel. Requires "Message Content Intent" ON in the Developer Portal (Bot tab).
FEED_CHANNEL_ID=

# --- Misc ------------------------------------------------------------------
DATABASE_PATH=data/nfl_universe.db
LOG_LEVEL=INFO
